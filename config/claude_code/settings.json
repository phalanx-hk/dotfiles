{
  "env": {
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_BUG_COMMAND": "true",
    "effort": "medium"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "MultiEdit",
      "WebFetch",
      "WebSearch",
      "Skill",
      "Read(~/.claude/skills/*/references/**)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(chmod 777:*)",
      "Bash(chown root:*)",
      "Bash(while true:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform apply:*)",
      "Bash(gcloud:*)",
      "Bash(gsutil:*)",
      "Bash(bq:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)",
      "NotebookEdit",
      "NotebookRead"
    ],
    "additionalDirectories": [
      "~/Google Drive/マイドライブ/Obsidian Vault/"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(endswith(\".py\"))' | xargs -r uvx ruff check --fix"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(endswith(\".py\"))' | xargs -r uvx mypy"
          },
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(test(\"\\\\.(css|js|jsx|ts|tsx|svelte)$\"))' | xargs -r bunx --bun biome check --write"
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cmux-notify.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cmux-notify.sh"
          }
        ]
      }
    ]
  },
  "showClearContextOnPlanAccept": true,
  "model": "opusplan",
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.py"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "dig@kuu-marketplace": true
  },
  "alwaysThinkingEnabled": true
}
